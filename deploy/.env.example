# Keep the service loopback-only and publish it with Tailscale Serve.
AGENT_BRIDGE_HUB_BIND=127.0.0.1
AGENT_BRIDGE_HUB_PORT=58080
AGENT_BRIDGE_HUB_NODE_ID=catalog-hub

# Generate separate random values locally. Never commit deploy/.env.
NATS_ADMIN_USER=bridge-admin
NATS_ADMIN_PASSWORD=replace-with-a-long-random-admin-password
NATS_CATALOG_USER=catalog
NATS_CATALOG_PASSWORD=replace-with-a-long-random-catalog-password

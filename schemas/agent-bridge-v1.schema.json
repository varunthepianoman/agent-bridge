{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Id"
        },
        "media_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Media Type"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "sensitivity": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sensitivity"
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "size": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Size"
        },
        "uri": {
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "name",
        "uri"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "DeliveryPolicy": {
      "additionalProperties": false,
      "properties": {
        "acknowledgement_timeout_seconds": {
          "default": 60.0,
          "exclusiveMinimum": 0,
          "title": "Acknowledgement Timeout Seconds",
          "type": "number"
        },
        "expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires At"
        },
        "max_attempts": {
          "default": 3,
          "maximum": 100,
          "minimum": 1,
          "title": "Max Attempts",
          "type": "integer"
        },
        "retry_backoff_seconds": {
          "default": 5.0,
          "minimum": 0,
          "title": "Retry Backoff Seconds",
          "type": "number"
        }
      },
      "title": "DeliveryPolicy",
      "type": "object"
    },
    "EndpointKind": {
      "enum": [
        "conversation",
        "node",
        "room",
        "endpoint"
      ],
      "title": "EndpointKind",
      "type": "string"
    },
    "EndpointRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/EndpointKind"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "title": "EndpointRef",
      "type": "object"
    },
    "MessageKind": {
      "enum": [
        "message",
        "request",
        "event",
        "response",
        "control"
      ],
      "title": "MessageKind",
      "type": "string"
    }
  },
  "$id": "https://agent-bridge.local/schemas/agent-bridge-v1.schema.json",
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "title": "Artifacts",
      "type": "array"
    },
    "body": {
      "additionalProperties": true,
      "title": "Body",
      "type": "object"
    },
    "causation_id": {
      "anyOf": [
        {
          "maxLength": 160,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Causation Id"
    },
    "correlation_id": {
      "anyOf": [
        {
          "maxLength": 160,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Correlation Id"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "delivery": {
      "$ref": "#/$defs/DeliveryPolicy"
    },
    "destination": {
      "$ref": "#/$defs/EndpointRef"
    },
    "extensions": {
      "additionalProperties": true,
      "title": "Extensions",
      "type": "object"
    },
    "kind": {
      "$ref": "#/$defs/MessageKind"
    },
    "message_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Message Id",
      "type": "string"
    },
    "reply_to": {
      "anyOf": [
        {
          "$ref": "#/$defs/EndpointRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema_version": {
      "const": "agent-bridge/v1",
      "default": "agent-bridge/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "sender": {
      "$ref": "#/$defs/EndpointRef"
    }
  },
  "required": [
    "message_id",
    "kind",
    "sender",
    "destination"
  ],
  "title": "AgentBridgeProtocolV1",
  "type": "object"
}

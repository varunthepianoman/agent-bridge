# Required private hub identity
AGENT_BRIDGE_HUB_URL=https://agent-bridge.example.ts.net
AGENT_BRIDGE_NODE_TOKEN=replace-with-per-node-token

# Stable location identity
AGENT_BRIDGE_NODE_ID=workstation-wsl
AGENT_BRIDGE_NODE_NAME=Workstation WSL
AGENT_BRIDGE_ENVIRONMENT_ID=ubuntu-dev
AGENT_BRIDGE_ENVIRONMENT_KIND=wsl

# Runtime policy
AGENT_BRIDGE_NODE_INTERVAL=15
AGENT_BRIDGE_HTTP_TIMEOUT=30
AGENT_BRIDGE_MAX_PROVIDER_CONCURRENCY=4
AGENT_BRIDGE_CODEX_BIN=codex
AGENT_BRIDGE_CLAUDE_BIN=claude

# Local privacy filters (comma-separated glob patterns)
AGENT_BRIDGE_EXCLUDE_PROVIDERS=
AGENT_BRIDGE_EXCLUDE_REPOSITORIES=*customer-private.git
AGENT_BRIDGE_EXCLUDE_FOLDERS=/srv/customer/*,C:\customer\*
AGENT_BRIDGE_EXCLUDE_CONVERSATIONS=
AGENT_BRIDGE_SYNC_TRANSCRIPTS=1
